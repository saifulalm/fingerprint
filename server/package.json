{
  "name": "fingerprint-server",
  "version": "1.0.0",
  "description": "Hikvision Fingerprint Attendance System — Backend",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "export:data": "node scripts/export-data.mjs",
    "setup": "npm run db:push && npm run db:generate && npm run seed",
    "test:scheduler": "node scripts/test-scheduler-email.mjs",
    "test:smtp": "node scripts/test-email-local.mjs",
    "test:email": "node scripts/test-email-local.mjs --send",
    "check:pdf-layout": "node scripts/probe-pdf-layout.mjs probe-layout.pdf && node scripts/run-pdf-layout-check.mjs probe-layout.pdf probe-layout-branded.pdf probe-layout-long-footer.pdf",
    "check:prisma-ids": "node scripts/check-prisma-id-defaults.mjs prisma/schema.prisma",
    "check:identity": "node scripts/test-identity-resolver.mjs",
    "check:async-handlers": "node scripts/check-async-handlers.mjs",
    "check:scheduler-email": "node scripts/check-scheduler-email.mjs",
    "check:report-names": "node scripts/check-report-names.mjs",
    "check:api-usage": "node scripts/check-api-response-usage.mjs",
    "check:device-roster": "node scripts/test-device-roster-match.mjs",
    "check:report-attach": "node scripts/test-report-attachment.mjs",
    "test:delivery": "node scripts/test-report-delivery.mjs",
    "match:roster": "node scripts/match-device-roster.mjs",
    "audit:device-users": "node scripts/audit-device-user-consistency.mjs",
    "audit:device-users:fix": "node scripts/audit-device-user-consistency.mjs --fix",
    "audit:id-aliases": "node scripts/audit-stale-id-aliases.mjs",
    "verify": "npm run check:prisma-ids && npm run check:identity && npm run check:async-handlers && npm run check:scheduler-email && npm run check:report-names && npm run check:api-usage && npm run check:device-roster && npm run check:report-attach && npm run check:pdf-layout && npm run test:delivery"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.2",
    "baileys": "^7.0.0-rc14",
    "cors": "^2.8.5",
    "dayjs": "^1.11.11",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.22.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
