# ═══════════════════════════════════════════════════════════════════════════════
# Fingerprint Attendance System — Contoh Konfigurasi Environment
# ═══════════════════════════════════════════════════════════════════════════════
#
# CARA PAKAI:
#   1. Salin file ini menjadi `server/.env`:
#        cp .env.example .env          (Linux/macOS)
#        copy .env.example .env        (Windows CMD)
#   2. Isi nilai yang ditandai "WAJIB" dengan kredensial asli Anda.
#   3. JANGAN PERNAH commit file `.env` — sudah otomatis di-ignore .gitignore.
#
# CATATAN PENTING TENTANG SUMBER KEBENARAN EMAIL:
#   Ada DUA sumber konfigurasi SMTP, dan yang di-DB (UI Pengaturan) menang:
#     a) Tabel `SystemSetting` — diisi lewat UI "Pengaturan" tab Email/SMTP.
#        Ini sumber utama. Password TIDAK pernah dikirim balik ke browser.
#     b) File `.env` di bawah — dipakai sebagai FALLBACK bila DB belum lengkap.
#
#   Aturan yang berlaku (lihat services/settingsService.js → resolveSmtpConfig):
#     - DB lengkap (host + user + pass) → dipakai apa adanya, env diabaikan.
#     - DB tidak lengkap → dipakai env (SMTP_HOST/SMTP_USER/SMTP_PASS).
#     - Keduanya kosong → email/scheduler tidak dapat mengirim, dan aplikasi
#       memberi tahu Anda dengan pesan yang jelas (bukan diam-diam gagal).
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL Database (WAJIB) ───────────────────────────────────────────────
# Koneksi ke PostgreSQL. Perhatikan: password TIDAK boleh mengandung karakter
# khusus yang perlu di-encode (mis. @ / # / ?). Kalau ada, encode sebagai %40.
#
# Contoh: postgresql://postgres:rahasia@localhost:5432/bioclock
DATABASE_URL="postgresql://postgres:password@localhost:5432/bioclock"

# ─── Server ───────────────────────────────────────────────────────────────────
# Port API backend. Jangan diubah kecuali ada konflik port.
PORT=6601

# Mode aplikasi: 'development' | 'production'
# WAJIB 'production' di server sungguhan — `SESSION_SECRET` akan diverifikasi
# dan server refuses to start tanpa secret yang valid (lihat config/index.js).
NODE_ENV=development


# ─── Session / JWT (WAJIB di production) ──────────────────────────────────────
# Secret untuk menandatangani JWT + cookie session.
#
# WAJIB diganti di production. Generate nilai acak yang kuat:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# BILA SESSION_SECRET kosong dan NODE_ENV=production → server GAGAL START
# (fail-fast). Di development boleh kosong (server memakai secret acak
# per-proses; token tidak berlaku lintas restart).
SESSION_SECRET=fp-session-secret-change-in-production


# ─── Admin Login ──────────────────────────────────────────────────────────────
# Kredensial login dashboard admin. WAJIB diganti di production.
ADMIN_USER=admin
ADMIN_PASS=admin123


# ─── Timezone (WIB = +07:00) ──────────────────────────────────────────────────
# Offset timezone untuk format tanggal & scheduler.
# Cron scheduler SELALU memakai timezone 'Asia/Jakarta' (hardcoded, WIB).
TZ_OFFSET=+07:00


# ─── Scheduler ────────────────────────────────────────────────────────────────
# Set 'false' untuk MENONAKTKAN seluruh cron job (jadwal tidak berjalan otomatis).
# Berguna saat instalasi hanya memakai tombol "Kirim Sekarang" di UI, atau
# saat server sedang diuji dan tidak ingin email terkirim berulang.
#
# Nilai yang menonaktifkan: false | 0 | no | off
SCHEDULER_ENABLED=true


# ─── Hikvision Device Credentials ─────────────────────────────────────────────
# Kredensial login ke perangkat absensi Hikvision.
# IP default sudah sesuai jaringan lokal (192.168.89.x) — ubah bila perangkat
# dipindah ke jaringan lain.
DEVICE_MASUK_IP=192.168.89.241
DEVICE_MASUK_USER=admin
DEVICE_MASUK_PASS=Hikvision12
DEVICE_KELUAR_IP=192.168.89.240
DEVICE_KELUAR_USER=admin
DEVICE_KELUAR_PASS=Hikvision12


# ─── SMTP / Email (FALLBACK — sumber utama ada di UI Pengaturan) ─────────────
#
# Isi bagian ini HANYA kalau Anda tidak ingin memakai tab "Pengaturan" di UI.
# Bila diisi, nilainya dipakai otomatis saat pengaturan di UI belum lengkap.
#
# WAJIB: SMTP_PASS untuk Gmail/Google Workspace = APP PASSWORD, bukan password
# biasa. Cara buat: https://myaccount.google.com/apppasswords
#
# ── Contoh tiap provider ────────────────────────────────────────────────────
#   Gmail / Google Workspace : host=smtp.gmail.com   port=587 secure=false
#   Outlook / Microsoft 365   : host=smtp.office365.com port=587 secure=false
#   Yahoo Mail               : host=smtp.mail.yahoo.com port=587 secure=false
#   Zoho Mail                : host=smtp.zoho.com     port=587 secure=false
#   SendGrid                 : host=smtp.sendgrid.net port=587 secure=false
#
# secure=true HANYA untuk port 465 (SSL/TLS langsung). Port 587 memakai
# STARTTLS (secure=false) — itu setting yang benar untuk Gmail.

# Hostname server SMTP (tanpa https://, tanpa port, tanpa @).
SMTP_HOST=smtp.gmail.com

# Port SMTP: 587 (STARTTLS, recommended) atau 465 (SSL/TLS).
SMTP_PORT=587

# true HANYA bila port = 465. Untuk port 587 biarkan false.
SMTP_SECURE=false

# Username SMTP. Untuk Gmail = alamat email lengkap pengirim.
SMTP_USER=your-email@gmail.com

# Password / App Password. Jangan dikosongkan di produksi.
SMTP_PASS=your-app-password

# Alamat/nama pengirim yang tampil di inbox penerima.
# Boleh dalam format: "Fingerprint System <noreply@company.com>"
# BILA kosong, otomatis memakai SMTP_USER.
SMTP_FROM=your-email@gmail.com


# ─── WhatsApp (whatsapp-web.js session) ──────────────────────────────────────
# Folder tempat sesi WhatsApp disimpan. Path relatif di-resolve dari folder
# server. WAJIB ada & writable, kalau tidak pairing QR gagal.
WHATSAPP_SESSION_DIR=sessions/whatsapp

# Folder sesi Baileys (jalur pairing QR). Kalau kosong, memakai default
# bawaan aplikasi. Path relatif di-resolve dari folder server.
WHATSAPP_BAILEYS_SESSION_DIR=sessions/baileys


# ─── WhatsApp OpenWA Gateway (opsional) ─────────────────────────────────────
#
# Bila WA_GATEWAY_URL diisi, aplikasi memakai jalur gateway OpenWA; bila kosong,
# aplikasi memakai pairing Baileys langsung (QR di halaman WhatsApp).
#
# Kontrak mengikuti spesifikasi OpenWA:
#   - Semua route ada di bawah prefix `/api` (URL di bawah TIDAK perlu /api).
#   - API key dikirim lewat header `X-API-Key` (TIDAK pernah di URL).
#   - WA_GATEWAY_SESSION = NAMA sesi (3-50 karakter, huruf/angka/hyphen).
#     ID sesi (UUID) dicari otomatis lewat `GET /api/sessions?name=<nama>`.
#
# CATATAN: bila memakai gateway Fonnte/WaBlas (bukan OpenWA), isi
# WA_GATEWAY_KEY dengan token API — token dikirim sebagai header Authorization.
#
# WA_GATEWAY_URL=http://localhost:2785
# WA_GATEWAY_API_KEY=owa_k1_your-api-key-here
# WA_GATEWAY_KEY=your-fonnte-token
# WA_GATEWAY_SESSION=bioclock
# WA_GATEWAY_TYPE=fonnte

# Timeout request ke gateway (milidetik). Default 8000.
WA_GATEWAY_TIMEOUT_MS=8000


# ─── Chrome path (WhatsApp Web on Windows — auto-detected, optional) ───────
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe


# ─── Report defaults ───────────────────────────────────────────────────────────
# Bahasa laporan default: 'id' (Indonesia) atau 'en' (English).
#
# CATATAN: nilai di sini dipakai HANYA sebagai fallback. Bila tab "Pengaturan"
# sudah punya "Bahasa Laporan Default", nilai UI yang menang.
REPORT_DEFAULT_LANG=id

# Penerima default laporan (dipisah koma) — dipakai bila jadwal tidak punya
# kolom penerima sendiri. CATATAN: bila Pengaturan sudah punya "Penerima
# Default Laporan", nilai UI yang menang.
REPORT_DEFAULT_RECIPIENTS=hrd@company.com,finance@company.com


# ─── CORS / Allowed Origins ──────────────────────────────────────────────────
# Daftar origin browser yang BOLEH memanggil API. Pisahkan dengan koma.
# KOSONG = tidak ada header CORS yang dikirim → browser memblokir cross-origin
# (aman untuk instalasi lokal, karena frontend di-serve dari origin yang sama).
#
# Contoh untuk frontend dev di Vite (port 6602):
#   ALLOWED_ORIGINS=http://localhost:6602
ALLOWED_ORIGINS=


# ─── Ambang keterlambatan ─────────────────────────────────────────────────────
# Jam kerja normal dalam format HH:MM. Dipakai untuk deteksi terlambat.
# (Nilai per-sistem di UI "Pengaturan" — Jam Masuk/Pulang — lebih diprioritaskan.)
LATE_THRESHOLD_HOURS=09:00
